{
	"name": "fruster-user-service",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"start": "fruster-runner ./app.ts",
		"start:dist": "node ./dist/app.js",
		"build": "fruster-runner ./app.ts --build",
		"clean": "rimraf ./dist",
		"test": "nyc --reporter=html --check-coverage --lines 90 fruster-runner ./spec/support/jasmine-runner.ts",
		"tunnel": "devspace dev"
	},
	"dependencies": {
		"@fruster/bus": "1.2.0-alpha.0",
		"@fruster/decorators": "^1.2.0-alpha.0",
		"@fruster/health": "1.2.0-alpha.0",
		"@fruster/log": "1.2.0-alpha.0",
		"@fruster/runner": "^1.2.0-alpha.0",
		"body-parser": "^2.3.0",
		"cookie-parser": "^1.4.7",
		"csprng": "^0.1.2",
		"express": "^5.2.1",
		"http-proxy-middleware": "^3.0.7",
		"mongodb": "^5.9.2",
		"uuid": "^14.0.1"
	},
	"devDependencies": {
		"@fruster/test-utils": "1.2.0-alpha.0",
		"@types/jasmine": "^6.0.0",
		"@types/node": "^26.1.0",
		"jasmine": "^6.3.0",
		"jasmine-spec-reporter": "^7.0.0",
		"mongodb-memory-server": "^11.2.0",
		"nyc": "^18.0.0",
		"rimraf": "^6.1.3",
		"typescript": "~5.9.3"
	},
	"nyc": {
		"exclude": [
			"web",
			"spec/*",
			"config.ts",
			"lib/deprecatedErrors.ts",
			"lib/errors.ts",
			"lib/constants.ts",
			"lib/docs.ts",
			"lib/repos/AbstractRoleScopesRepo.ts",
			"lib/repos/RoleScopesConfigRepo.ts"
		]
	}
}